table DimProviderType
	lineageTag: 31e49553-324c-41bd-9134-c0f0da6c3f2c

	column ProviderTypeKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 6d2a6d0c-8d62-4c2f-8710-6a2a2fb7e913
		summarizeBy: none
		sourceColumn: ProviderTypeKey

		annotation SummarizationSetBy = Automatic

	column ProviderTypeCode
		dataType: string
		lineageTag: a1abd94f-3091-4bee-84a2-183f65c3f777
		summarizeBy: none
		sourceColumn: ProviderTypeCode

		annotation SummarizationSetBy = Automatic

	column ProviderTypeLabel =
			
			SWITCH (
			    DimProviderType[ProviderTypeCode],
			    "0", "Clinics / Groups / Associations",
			    "1", "Solo Physicians / Suppliers",
			    "3", "Institutional Provider",
			    "5", "Multi-Specialty Clinics",
			    "7", "Other Entities",
			    "8", "EI-Coded / Proprietorship Entities",
			    "Code " & DimProviderType[ProviderTypeCode]
			)
		lineageTag: 5cef3e2a-12c4-4642-bbd8-91ed91d6a2d3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition DimProviderType = m
		mode: import
		source =
				let
				    Source = Sql.Database("localhost", "HealthcareGovernanceQC"),
				    analytics_DimProviderType = Source{[Schema="analytics",Item="DimProviderType"]}[Data]
				in
				    analytics_DimProviderType

	annotation PBI_ResultType = Table

