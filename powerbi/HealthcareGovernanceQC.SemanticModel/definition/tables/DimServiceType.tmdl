table DimServiceType
	lineageTag: e7874c31-59aa-4dd5-acb5-210d3f8277a7

	column ServiceTypeKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: de5dfb26-a78b-4a20-9f47-9258e98614be
		summarizeBy: none
		sourceColumn: ServiceTypeKey

		annotation SummarizationSetBy = Automatic

	column ServiceTypeCode
		dataType: string
		lineageTag: 4f024c1b-7916-4210-87e1-e699fd48bd3e
		summarizeBy: none
		sourceColumn: ServiceTypeCode

		annotation SummarizationSetBy = Automatic

	column ServiceTypeLabel =
			
			SWITCH (
			    DimServiceType[ServiceTypeCode],
			    "0", "Whole Blood Only",
			    "1", "Medical Care",
			    "2", "Surgery",
			    "3", "Consultation",
			    "4", "Diagnostic Radiology",
			    "5", "Diagnostic Laboratory",
			    "6", "Therapeutic Radiology",
			    "7", "Anesthesia",
			    "8", "Assistant at Surgery",
			    "9", "Other Medical Items / Services",
			    "D", "Ambulance",
			    "F", "Ambulatory Surgical Center",
			    "G", "Immunosuppressive Drugs",
			    "K", "Hearing Items / Services",
			    "N", "Kidney Donor",
			    "P", "DME / Prosthetics / Orthotics",
			    "Q", "Vision Items / Services",
			    "S", "Surgical Dressings / Supplies",
			    "T", "Outpatient Mental Health Limitation",
			    "V", "Pneumococcal / Flu Vaccine",
			    "Code " & DimServiceType[ServiceTypeCode]
			)
		lineageTag: 074c70e7-6cf1-42ca-955b-1fa0a16a3b06
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition DimServiceType = m
		mode: import
		source =
				let
				    Source = Sql.Database("localhost", "HealthcareGovernanceQC"),
				    analytics_DimServiceType = Source{[Schema="analytics",Item="DimServiceType"]}[Data]
				in
				    analytics_DimServiceType

	annotation PBI_ResultType = Table

